# Copy to .env.local and fill in your own values.
#
# No login is required — there is no auth layer on this admin app. If you
# deploy it anywhere reachable beyond your own machine, put it behind
# something that gates access yourself (a VPN, Vercel deployment protection,
# a reverse proxy with basic auth, etc.).

# Neon Postgres connection string (same database as the worker)
DATABASE_URL=

# https://firecrawl.dev
FIRECRAWL_API_KEY=

# https://console.anthropic.com — used for framework analyses (claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# The worker's URL and the same WORKER_SECRET set in apps/worker/.env.local
WORKER_URL=
WORKER_SECRET=
