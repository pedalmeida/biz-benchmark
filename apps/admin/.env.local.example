# Copy to .env.local and fill in your own values.

# Neon Postgres connection string (same database as the worker)
DATABASE_URL=

# NextAuth: generate with `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth (console.cloud.google.com > Credentials > OAuth client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Your deployed admin app URL, e.g. http://localhost:3001 in dev
NEXTAUTH_URL=

# https://firecrawl.dev
FIRECRAWL_API_KEY=

# https://console.anthropic.com — used for framework analyses (claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# The worker's URL and the same WORKER_SECRET set in apps/worker/.env.local
WORKER_URL=
WORKER_SECRET=
