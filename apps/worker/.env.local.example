# Copy to .env.local and fill in your own values.

# Neon Postgres connection string
DATABASE_URL=

# Shared secret with the admin app — generate any random string,
# must match WORKER_SECRET in apps/admin/.env.local exactly.
WORKER_SECRET=

# https://firecrawl.dev — used to scrape the Meta Ad Library
FIRECRAWL_API_KEY=

# https://console.anthropic.com — used for keyword expansion, the discovery
# relevance pass, hook classification, and funnel extraction
ANTHROPIC_API_KEY=

# Caps enforced during a run — see docs/ for the full design
MAX_COMPETITORS_PER_RUN=8
MAX_KEYWORDS_PER_RUN=5
MAX_ADS_CLASSIFIED_PER_COMPETITOR=60
MAX_FUNNEL_PAGES_PER_COMPETITOR=3
RUN_COST_CAP_CENTS=200
RUN_CACHE_DAYS=14

# Optional, defaults to 3002
PORT=
