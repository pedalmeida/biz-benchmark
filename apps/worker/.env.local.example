# Copy to .env.local and fill in your own values.

# Neon Postgres connection string
DATABASE_URL=

# Shared secret with the admin app — generate any random string,
# must match WORKER_SECRET in apps/admin/.env.local exactly.
WORKER_SECRET=

# https://firecrawl.dev — used to scrape the Meta Ad Library
FIRECRAWL_API_KEY=

# Optional, defaults to 3002
PORT=
